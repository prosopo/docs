{
  "name": "docs",
  "version": "2.5.5",
  "private": true,
  "engines": {
    "node": "^24",
    "npm": "^11"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:cjs": "echo 'no cjs build'",
    "clean": "echo 'no clean command'",
    "preview": "astro preview",
    "check": "astro check",
    "format": "pnpm run format:code",
    "format:ci": "pnpm run format:imports && pnpm run format:code",
    "format:code": "prettier -w . --cache --plugin-search-dir=.",
    "format:imports": "organize-imports-cli ./tsconfig.json",
    "lint:slugcheck": "node ./scripts/lint-slugcheck.mjs",
    "lint:eslint": "eslint . --quiet",
    "lint": "npm run eslint",
    "lint:fix": "npm run eslint:fix",
    "eslint": "npm run lint:eslint",
    "eslint:fix": "npm run lint:eslint -- --fix",
    "prepare": "husky",
    "pkgjson": "f() { npx -w $1 node -e 'console.log(process.cwd()+\"/package.json\")' ;}; f",
    "pkgdir": "f() { npx -w $1 node -e 'console.log(process.cwd())' ;}; f",
    "depcheck": "npm run --silent ws:pkg | xargs -P 1 --verbose -I {} bash -c 'cd $(dirname {}) && npx depcheck --ignores vite,vitest,del-cli,concurrently,npm-run-all,tslib,typescript,tsx || true; echo \"\"'",
    "deps:ls": "npm run --silent ws:pkg | xargs -P 100 -I {} bash -c 'cat {} | jq .dependencies | head -n -1 | tail -n +2' | tr -d ',' | sort | uniq",
    "deps:dupe": "npm run deps:ls | awk -F': ' 'NF {count[$1]++; lines[$1] = lines[$1] $0 \"\\n\"} END {for (pkg in count) if (count[pkg] > 1) printf \"%s\", lines[pkg]}' | sort",
    "audit:fix": "npm audit fix --force",
    "deps:status": "npm-check-updates --deep",
    "deps:upgrade": "npm-check-updates --deep --interactive --format group"
  },
  "devDependencies": {
    "@astrojs/tailwind": "5.1.0",
    "@babel/core": "7.18.10",
    "@biomejs/biome": "1.9.1",
    "@docsearch/css": "3.5.1",
    "@taplo/cli": "0.7.0",
    "@types/hast": "3.0.3",
    "@types/html-escaper": "3.0.0",
    "@types/mdast": "4.0.3",
    "@types/node": "18.6.4",
    "@typescript-eslint/eslint-plugin": "6.13.2",
    "@typescript-eslint/parser": "6.0.0",
    "astro": "7.3.3",
    "astro-auto-import": "0.4.2",
    "astro-eslint-parser": "0.16.0",
    "astro-og-canvas": "0.5.0",
    "canvaskit-wasm": "0.39.1",
    "concurrently": "9.0.1",
    "del-cli": "6.0.0",
    "depcheck": "1.4.7",
    "eslint": "8.29.0",
    "eslint-plugin-astro": "0.21.0",
    "eslint-plugin-react": "7.32.1",
    "fast-glob": "3.2.11",
    "hast-util-from-html": "2.0.1",
    "hast-util-to-html": "9.0.1",
    "hast-util-to-string": "3.0.0",
    "hastscript": "8.0.0",
    "html-escaper": "3.0.3",
    "kleur": "4.1.5",
    "mdast-util-from-markdown": "2.0.0",
    "mdast-util-to-hast": "13.0.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-util-character": "2.0.1",
    "micromark-util-symbol": "2.0.0",
    "node-fetch": "3.2.10",
    "npm-check-updates": "17.1.1",
    "npm-run-all": "2.1.0",
    "organize-imports-cli": "0.10.0",
    "parse-numeric-range": "1.3.0",
    "prettier": "3.1.0",
    "prettier-plugin-astro": "0.12.2",
    "remark": "15.0.1",
    "remark-directive": "3.0.0",
    "rollup-plugin-polyfill-node": "0.13.0",
    "tslib": "2.7.0",
    "tsx": "4.19.1",
    "typescript": "5.0.2",
    "unified": "11.0.4",
    "unist-util-remove": "4.0.0",
    "unist-util-visit": "5.0.0",
    "unist-util-walker": "1.0.0",
    "vite-plugin-json5": "1.1.2",
    "vite-plugin-node-polyfills": "0.24.0"
  },
  "dependencies": {
    "@astrojs/check": "0.7.0",
    "@astrojs/sitemap": "3.1.5",
    "@astrojs/starlight": "0.25.0",
    "@astrojs/starlight-tailwind": "2.0.3",
    "@docsearch/js": "3.5.2",
    "@fontsource/ibm-plex-mono": "4.5.10",
    "husky": "9.1.7",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.0",
    "remark-smartypants": "2.0.0",
    "sass": "1.54.3",
    "sharp": "0.35.4"
  },
  "npm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@types/react",
        "fsevents",
        "react",
        "react-dom",
        "vite"
      ]
    }
  },
  "optionalDependencies": {
    "fsevents": "2.3.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    },
    "fsevents": "2.3.2"
  }
}
