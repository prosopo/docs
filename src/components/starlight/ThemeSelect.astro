---
import { Icon } from '@astrojs/starlight/components';
---

<starlight-theme-select>
	<button type="button" aria-label="Switch between light and dark mode" title="Switch between light and dark mode">
		<Icon name="sun" class="icon-sun" />
		<Icon name="moon" class="icon-moon" />
	</button>
</starlight-theme-select>

<script>
	const storageKey = 'starlight-theme';

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			this.querySelector('button')?.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
				document.documentElement.dataset.theme = next;
				try {
					localStorage.setItem(storageKey, next);
				} catch {
					// Storage can be refused (private browsing); the choice still applies to this page.
				}
			});
		}
	}
	customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>

<style>
	button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.375rem;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition: color 0.15s;
	}
	button:hover {
		color: var(--sl-color-text-accent);
	}
	button :global(svg) {
		width: 1rem;
		height: 1rem;
	}
	:global([data-theme='dark'] .icon-moon),
	:global([data-theme='light'] .icon-sun) {
		display: none;
	}
</style>
