---
import { getCollection } from 'astro:content';
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import type { StarlightRouteData } from '@astrojs/starlight/route-data';

type SidebarEntry = StarlightRouteData['sidebar'][number];

const route = Astro.locals.starlightRoute;
const docIds = new Set((await getCollection('docs')).map((entry) => entry.id));

function remap(i: SidebarEntry): SidebarEntry {
	if (i.type === 'group') {
		i.entries = i.entries.map(remap);
		return i;
	}

	const itemSlug = i.href.replace(/^\/+|\/+$/g, '');
	i.attrs.class = docIds.has(itemSlug) ? undefined : 'fallback';
	return i;
}

route.sidebar = route.sidebar.map(remap);
---

<SidebarPersister><SidebarSublist sublist={route.sidebar} /></SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

<style>
	:global(.fallback)::after {
		content: 'EN';
		vertical-align: super;
		font-size: 0.75em;
		font-weight: 700;
	}
</style>
