---
import logo from '~/assets/prosopo-logo.svg?raw';
import type { Props } from '@astrojs/starlight/props';

const main = 'https://prosopo.io/';
const self = '/' + (Astro.props.locale || 'en') + '/welcome/';
---

<span class="site-title sl-flex">
	<a class="brand-logo" href={main} set:html={logo} aria-label="Prosopo" />
	<a class="docs-label" href={self}>Docs</a>
</span>

<style>
	.site-title {
		align-items: center;
		gap: 0.875rem;
	}
	.site-title a {
		display: flex;
		align-items: center;
		text-decoration: none;
	}
	.brand-logo {
		color: var(--sl-color-white);
	}
	.docs-label {
		padding-inline-start: 0.875rem;
		border-inline-start: 1px solid var(--sl-color-hairline-light);
		color: var(--sl-color-text-accent);
		font-size: var(--sl-text-lg);
		font-weight: 600;
		line-height: 1.75rem;
	}
	.docs-label:hover {
		color: var(--sl-color-white);
	}
	.site-title a:focus-visible {
		outline: 0;
	}
	.site-title a:focus-visible > :global(*),
	.docs-label:focus-visible {
		outline: auto;
		outline-offset: 0.33rem;
		border-radius: 1px;
	}
	.site-title :global(svg) {
		width: auto;
		height: 1.5rem;
		margin-block: calc((var(--sl-nav-height) - 1.5rem) / 2);
	}
</style>
